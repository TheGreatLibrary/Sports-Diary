    <!-- 3. FFMI -->
    <string name="calc_ffmi_title">Fat-Free Mass Index (FFMI)</string>
    <string name="calc_ffmi_desc">Shows the amount of lean muscle mass relative to height. A value of 19–20 is average for men, 22–23 is a well-trained athlete, and around 25 is the upper genetic limit without pharmacology.</string>
