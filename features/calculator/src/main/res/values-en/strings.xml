    <!-- 4. RPE / RIR -->
    <string name="calc_rpe_title">Working weight by RPE / RIR</string>
    <string name="calc_rpe_desc">Calculates the optimal barbell working weight based on your 1RM, target rep count, and desired reserve (RIR — how many more reps you could have lifted before failure).</string>
